# Copy to .env.local and fill in. Only the first three are required to run
# a screening end to end; everything else has a sensible default.

# ---- Required ----

# Greenhouse Harvest API v1 key (sent as the Basic Auth username).
GREENHOUSE_API_KEY=

# Anthropic API key for rubric generation, triage, scoring, and batches.
ANTHROPIC_API_KEY=

# Postgres connection string. All run, rubric, artifact, batch and cache state
# lives here. Locally, ./rosie-restart starts a Cloud SQL Auth Proxy on 5433.
DATABASE_URL=postgresql://user:password@127.0.0.1:5433/rosie

# ---- Storage ----

# GCS bucket for resume blobs (content-addressed by SHA-256). Unset disables
# blob offload; extracted text still lands in Postgres.
ROSIE_GCS_BUCKET=

# ---- Production auth (Google IAP) ----
# Local development authenticates automatically as an operator on loopback;
# production fails closed unless IAP is configured.

# IAP audience: /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE
ROSIE_IAP_AUDIENCE=
# Comma-separated operator emails. Everyone else IAP admits is a viewer.
ROSIE_ADMIN_EMAILS=
# OIDC identities allowed to invoke /api/cron/watchdog and /api/cron/refresh
# (the Cloud Scheduler service account).
ROSIE_CRON_INVOKERS=
# Audience for OIDC tokens minted for internal tick/watchdog calls.
ROSIE_OIDC_AUDIENCE=
# Shared secret alternative for cron auth (prefer OIDC).
CRON_SECRET=
# Trusted base URL for authenticated internal tick requests.
ROSIE_BASE_URL=
# Set to 1 to log IAP verification failures in detail.
ROSIE_IAP_DEBUG=
# Set to 1 to return 503 for everything except /api/auth/check.
ROSIE_MAINTENANCE=

# ---- Greenhouse behavior ----

# Stage whose candidates get screened (default: Application Review).
GREENHOUSE_TARGET_STAGE=
# Your Greenhouse shard host for deep links, e.g. https://app2.greenhouse.io —
# the generic host 404s for sharded tenants.
ROSIE_GREENHOUSE_APP_HOST=
# Stage that signals hiring-manager endorsement; the exemplar-cascade floor is
# derived structurally as one rung above it (default: Hiring Manager Review).
ROSIE_CALIBRATION_ENDORSEMENT_STAGE=
# Earliest stage eligible for automatic calibration exemplars (default: Onsite).
ROSIE_CALIBRATION_MIN_STAGE=

# ---- Screening behavior ----

# Set to false to bypass triage and full-score every viable candidate.
ROSIE_TRIAGE_ENABLED=
# Fraction of likely-no candidates to audit with a full score, 0..1 (default 0.1).
ROSIE_AUDIT_SAMPLE_RATE=
# Fresh-candidate count at which a stage switches to the Message Batches API
# (default 40).
ROSIE_BATCH_THRESHOLD=

# ---- Models (Anthropic API provider) ----

# Full-scoring model (default claude-sonnet-5). ANTHROPIC_MODEL is an alias.
ANTHROPIC_FULL_SCORE_MODEL=
# Triage model (default claude-haiku-4-5).
ANTHROPIC_TRIAGE_MODEL=
# Rubric and calibration models default to the full-scoring model.
ANTHROPIC_RUBRIC_MODEL=
ANTHROPIC_CALIBRATION_MODEL=

# ---- Subprocess providers (optional runtimes behind the same contract) ----

# Comma-separated providers executable in this environment (default: api).
# Options: api, claude-agent, codex-agent.
ROSIE_EXECUTABLE_PROVIDERS=
# Sole credential handed to the claude -p subprocess.
CLAUDE_CODE_OAUTH_TOKEN=
ROSIE_CLAUDE_FULL_MODEL=
ROSIE_CLAUDE_TRIAGE_MODEL=
# Isolated CODEX_HOME for codex exec (default ~/.rosie-codex).
ROSIE_CODEX_HOME=
ROSIE_CODEX_FULL_MODEL=
ROSIE_CODEX_TRIAGE_MODEL=
ROSIE_CODEX_FULL_EFFORT=
ROSIE_CODEX_TRIAGE_EFFORT=
# Concurrent subprocess scorings per tick (default 3).
ROSIE_AGENT_CONCURRENCY=
